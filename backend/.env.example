GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# OAuth 콜백은 프론트의 same-origin 프록시 경로로 받아야 세션 쿠키가 vercel.app 도메인에
# 저장됩니다. (Google Cloud Console 의 '승인된 리디렉션 URI' 에도 이 주소를 등록하세요)
#   개발:  http://localhost:5173/api/auth/callback
REDIRECT_URI=https://your-app.vercel.app/api/auth/callback
SECRET_KEY=your-random-secret-key-here
FRONTEND_URL=https://your-app.vercel.app
